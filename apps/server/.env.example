# Discord Control Hub Environment Configuration

PORT=3001
DATABASE_URL="file:./dev.db"
JWT_SECRET="discord-control-hub-session-secret-key-32chars"

# Discord Developer Portal Credentials
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_BOT_TOKEN=""
DISCORD_REDIRECT_URI="http://localhost:3001/api/v1/auth/callback"
FRONTEND_URL="http://localhost:5173"

# Set to true to enable Demo Mode (simulates Discord guilds/bot if tokens not provided)
DEMO_MODE=true
